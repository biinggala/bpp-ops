{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bpp-ops",
  "version": "1.4.2",
  "identifier": "kr.co.bpp.ops",
  "build": {
    "frontendDist": "https://crng-task-manager.web.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "bpp-ops",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://crng-task-manager.web.app/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDNDI0RUQ4MjMwMEIyOApSV1FvQ3pDQzdTVEVDUEliN2ppb3FFc0FOYmhVMnVyajRuSG9weUhNZ2FZdlFYbnVDZGJ0eXNsbgo="
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
