{
  "name": "bpp-ops-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing bpp-ops tasks over the Model Context Protocol",
  "bin": {
    "bpp-ops-mcp": "./dist/index.js",
    "bpp-ops-mcp-http": "./dist/http.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node --test test/access.test.js test/assign.test.js test/backfill.test.js test/note.test.js test/note-html.test.js test/notion.test.js test/push.test.js",
    "start:http": "node dist/http.js",
    "backfill": "node dist/backfill.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/web-push": "^3.6.4",
    "typescript": "~6.0.2"
  }
}
